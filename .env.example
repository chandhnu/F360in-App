# F360IN Environment Configuration

# App Configuration
APP_NAME=F360in
APP_VERSION=1.0.0
ENVIRONMENT=development

# Database
DATABASE_NAME=f360in.db
DATABASE_VERSION=1

# API Configuration (for future use)
API_BASE_URL=https://api.f360in.local
API_TIMEOUT=30000

# Feature Flags
ENABLE_ANALYTICS=false
ENABLE_CRASH_REPORTING=false
ENABLE_LOGGING=true

# Firebase (optional, for future)
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
